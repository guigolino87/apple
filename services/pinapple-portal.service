[Unit]
Description=PiNAPPLE captive portal handler
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/pinapple
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/pinapple/venv/bin/python3 /opt/pinapple/portal_handler.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
