[Unit]
Description=PiNAPPLE hostapd access point (wlan0)
After=network.target
Wants=pinapple-dhcp.service
Before=pinapple-dhcp.service

[Service]
Type=simple
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStartPre=/bin/sh -c 'ip link set wlan0 down || true; ip addr flush dev wlan0 || true; ip addr add 10.0.0.1/24 dev wlan0 || true; ip link set wlan0 up'
ExecStart=/usr/sbin/hostapd /etc/hostapd/hostapd.conf
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
