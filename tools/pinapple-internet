#!/usr/bin/env bash
# PiNAPPLE internet passthrough toggle (idempotent).
# Usage: pinapple-internet on|off
set -euo pipefail

action="${1:-on}"
wan="eth0"
ap="wlan0"

gw_ip="$(ip -4 -o addr show "$ap" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n1 || true)"
gw_ip="${gw_ip:-10.0.0.1}"
subnet="$(echo "$gw_ip" | awk -F. '{print $1"."$2"."$3".0/24"}')"

case "$action" in
  on)
    sysctl -w net.ipv4.ip_forward=1 >/dev/null
    iptables -w -t nat -C POSTROUTING -o "$wan" -s "$subnet" -j MASQUERADE 2>/dev/null \
      || iptables -w -t nat -A POSTROUTING -o "$wan" -s "$subnet" -j MASQUERADE
    iptables -w -C FORWARD -i "$ap" -o "$wan" -j ACCEPT 2>/dev/null \
      || iptables -w -A FORWARD -i "$ap" -o "$wan" -j ACCEPT
    iptables -w -C FORWARD -i "$wan" -o "$ap" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null \
      || iptables -w -A FORWARD -i "$wan" -o "$ap" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
    echo "internet passthrough on ($subnet -> $wan)"
    ;;
  off)
    iptables -w -t nat -D POSTROUTING -o "$wan" -s "$subnet" -j MASQUERADE 2>/dev/null || true
    iptables -w -D FORWARD -i "$ap" -o "$wan" -j ACCEPT 2>/dev/null || true
    iptables -w -D FORWARD -i "$wan" -o "$ap" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || true
    echo "internet passthrough off"
    ;;
  *)
    echo "usage: $0 on|off" >&2
    exit 1
    ;;
esac
